# =============================================================================
# Distributed Wagering Processor: variáveis de ambiente
#
#   cp .env.example .env
#
# Valores abaixo servem para rodar a APLICAÇÃO NA SUA MÁQUINA (bun run start)
# contra o PostgreSQL e o LocalStack do `docker compose up -d postgres localstack`.
# Dentro do Docker Compose estas variáveis já são injetadas pelo docker-compose.yml.
#
# ATENÇÃO: o Bun carrega o arquivo .env AUTOMATICAMENTE, inclusive em `bun test`.
# Os testes de integração/concorrência LEEM `DATABASE_URL` e RECRIAM o schema do
# banco apontado (DROP SCHEMA public CASCADE). Portanto, ao rodar testes, informe
# a URL de um banco descartável na linha de comando (a variável do shell tem
# precedência sobre o .env):
#
#   DATABASE_URL=postgres://wagering:wagering@127.0.0.1:5432/wagering_test \
#     bun run test:integration
#
# Nunca aponte DATABASE_URL de teste para um banco com dados.
# =============================================================================


# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
PORT=3000                     # porta da API (padrão 3000; no compose cada instância mapeia 3001..3003)
LOG_LEVEL=info                # debug | info | warn | error


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Conexão da APLICAÇÃO (obrigatória). Usa o role de menor privilégio `wagering_app`,
# que NÃO pode UPDATE/DELETE/TRUNCATE o ledger (criado por infra/postgres/init/).
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
ALLOW_TEST_DB_RESET=1

# Conexão do DONO do schema, usada só pelas migrations (`bun run migration:up`).
# Se omitida, o migrate cai para DATABASE_URL (que não tem permissão de DDL).
MIGRATION_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

# Pool e timeouts (opcionais; valores abaixo são os padrões)
# DB_POOL_MIN=2                       # inteiro >= 0, não pode exceder DB_POOL_MAX
# DB_POOL_MAX=20                      # inteiro >= 1
# DB_LOCK_TIMEOUT_MS=5000             # espera máxima pelo lock da carteira antes de erro transitório (503)
# DB_STATEMENT_TIMEOUT_MS=30000

# Diretório das migrations (opcional; padrão: ./migrations/sql)
# MIGRATIONS_DIR=./migrations/sql


# -----------------------------------------------------------------------------
# AWS / SQS (LocalStack em desenvolvimento)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566    # remova em produção para usar o SQS real
AWS_ACCESS_KEY_ID=test                # credenciais fictícias aceitas pelo LocalStack
AWS_SECRET_ACCESS_KEY=test

# Nomes das filas (opcionais; criadas por infra/localstack/init-queues.sh)
# SQS_QUEUE_TRANSACTIONS=wager-transactions.fifo
# SQS_QUEUE_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
# SQS_QUEUE_EVENTS=wager-events.fifo


# -----------------------------------------------------------------------------
# Papéis em background desta instância (todos seguros com N instâncias)
# Aceitam true/false, 1/0, yes/no.
# -----------------------------------------------------------------------------
# ROLE_CONSUMER=true                  # consome wager-transactions.fifo
# ROLE_OUTBOX_PUBLISHER=true          # publica o outbox em wager-events.fifo
# ROLE_PENDING_REFERENCE=true         # reprocessa transações em PENDING_REFERENCE


# -----------------------------------------------------------------------------
# Consumidor SQS (opcionais; valores abaixo são os padrões)
# -----------------------------------------------------------------------------
# CONSUMER_MAX_RECEIVE_COUNT=5        # tentativas antes da DLQ; precisa ser < 10 (RedrivePolicy da fila)
# CONSUMER_POLLERS=2
# CONSUMER_BATCH_SIZE=10
# CONSUMER_WAIT_SECONDS=20            # long polling; 0 desativa
# SHUTDOWN_TIMEOUT_MS=25000           # tempo para drenar mensagens em voo no SIGTERM


# -----------------------------------------------------------------------------
# Referências fora de ordem (PENDING_REFERENCE) (opcionais; valores abaixo são os padrões)
# -----------------------------------------------------------------------------
# REFERENCE_MAX_ATTEMPTS=10
# REFERENCE_TTL_MS=900000             # 15 min
# REFERENCE_BASE_DELAY_MS=2000        # não pode exceder REFERENCE_MAX_DELAY_MS
# REFERENCE_MAX_DELAY_MS=120000


# -----------------------------------------------------------------------------
# Back office (backoffice/; `bun run backoffice:start`; no compose já vem configurado)
# Usa DATABASE_URL acima. Atenção: a porta NÃO é PORT, que é a da API.
# -----------------------------------------------------------------------------
# BACKOFFICE_PORT=4000
# API_BASE_URLS=http://localhost:3001,http://localhost:3002,http://localhost:3003   # reconciliação usa a 1ª; métricas, todas
# BACKOFFICE_TOKEN=troque-por-um-segredo   # se definido, /api exige "Authorization: Bearer <token>"; sem ele a API do painel fica aberta


# =============================================================================
# Somente testes e carga
# =============================================================================
# E2E (`bun run test:e2e`): lista das instâncias; sem isto o E2E é PULADO.
# E2E_BASE_URLS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Teste de carga (`bun run test:load`) ; recria o schema de DATABASE_URL.
# Recusa bancos cujo nome não termine em _test, salvo LOAD_TEST_ALLOW_RESET=1.
# DURATION_S=15
# CONCURRENCY=32
# WALLETS=200
# HOT_RATIO=0.2                       # fração do tráfego que vai para carteiras quentes
# DUP_RATIO=0.1                       # fração de reenvios duplicados
# OUT=load-test-results.json
# LOAD_TEST_ALLOW_RESET=1
